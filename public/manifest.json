{
  "manifest_version": 3,
  "name": "Chat Colors",
  "short_name": "Chat Colors",
  "version": "1.1.0",
  "description": "Color-code your ChatGPT sidebar conversations with manual colors and local keyword rules. No data leaves your browser.",
  "minimum_chrome_version": "114",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Chat Colors"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
